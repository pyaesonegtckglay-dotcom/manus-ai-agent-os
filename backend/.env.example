# PSP AI Backend Environment Variables
# Copy this file to .env and fill in your API keys

# Gemini API Keys (up to 6)
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3
GEMINI_API_KEY_4=your_gemini_key_4
GEMINI_API_KEY_5=your_gemini_key_5
GEMINI_API_KEY_6=your_gemini_key_6

# SambaNova API Keys (up to 10)
SAMBANOVA_API_KEY_1=your_sambanova_key_1
SAMBANOVA_API_KEY_2=your_sambanova_key_2
SAMBANOVA_API_KEY_3=your_sambanova_key_3
SAMBANOVA_API_KEY_4=your_sambanova_key_4
SAMBANOVA_API_KEY_5=your_sambanova_key_5
SAMBANOVA_API_KEY_6=your_sambanova_key_6
SAMBANOVA_API_KEY_7=your_sambanova_key_7
SAMBANOVA_API_KEY_8=your_sambanova_key_8
SAMBANOVA_API_KEY_9=your_sambanova_key_9
SAMBANOVA_API_KEY_10=your_sambanova_key_10

# OpenRouter API Keys (up to 10)
OPENROUTER_API_KEY_1=your_openrouter_key_1
OPENROUTER_API_KEY_2=your_openrouter_key_2
OPENROUTER_API_KEY_3=your_openrouter_key_3
OPENROUTER_API_KEY_4=your_openrouter_key_4
OPENROUTER_API_KEY_5=your_openrouter_key_5
OPENROUTER_API_KEY_6=your_openrouter_key_6
OPENROUTER_API_KEY_7=your_openrouter_key_7
OPENROUTER_API_KEY_8=your_openrouter_key_8
OPENROUTER_API_KEY_9=your_openrouter_key_9
OPENROUTER_API_KEY_10=your_openrouter_key_10

# GitHub LLM Market Keys (up to 10)
LLM_MARKET_KEY_1=your_github_key_1
LLM_MARKET_KEY_2=your_github_key_2
LLM_MARKET_KEY_3=your_github_key_3
LLM_MARKET_KEY_4=your_github_key_4
LLM_MARKET_KEY_5=your_github_key_5
LLM_MARKET_KEY_6=your_github_key_6
LLM_MARKET_KEY_7=your_github_key_7
LLM_MARKET_KEY_8=your_github_key_8
LLM_MARKET_KEY_9=your_github_key_9
LLM_MARKET_KEY_10=your_github_key_10

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://user:password@host:6379

# HuggingFace
HF_TOKEN=your_huggingface_token

# Vercel (for frontend)
VERCEL_TOKEN=your_vercel_token

# E2B (for code execution)
E2B_API_KEY=your_e2b_api_key

# Interface Mode (gradio or fastapi)
INTERFACE=gradio
